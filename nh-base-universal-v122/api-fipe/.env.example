DATABASE_PATH=/app/data/fipe.sqlite3
# Obrigatória para publicar na internet; vazia desativa autenticação (apenas desenvolvimento).
API_KEY=
CORS_ORIGINS=
# Intervalo entre verificações; 86400 = 24h (mínimo 3600).
AUTO_SYNC_INTERVAL_SECONDS=86400
# Proteção contra snapshots truncados/defeituosos. Ajustável se necessário.
AUTO_SYNC_MIN_REGISTROS=1000
AUTO_SYNC_MAX_INVALIDOS_FRACAO=0.005
# Rejeita mês com menos de 70% dos registros do último mês válido (possível truncamento).
AUTO_SYNC_MIN_RATIO=0.70
LOG_LEVEL=INFO

# Performance da API (cache de respostas SQL limitado em memória).
QUERY_CACHE_TTL_SECONDS=3
QUERY_CACHE_MAX_ENTRIES=4000
# Número de processos HTTP no Docker; ajuste conforme CPU/RAM da VPS.
API_WORKERS=2

# Cache HTTP de JSON da rota /consulta (somente dados publicos, por worker).
HTTP_CACHE_TTL_SECONDS=3
HTTP_CACHE_MAX_ENTRIES=1024
HTTP_CACHE_MAX_RESPONSE_BYTES=131072
