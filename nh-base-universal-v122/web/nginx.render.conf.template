server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    charset utf-8;
    server_tokens off;
    client_max_body_size 450m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(self), microphone=(self), geolocation=(self)" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; script-src 'self'; connect-src 'self' https://formsubmit.co; base-uri 'self'; frame-ancestors 'self'; form-action 'self' https://wa.me https://formsubmit.co" always;

    location = /health { access_log off; add_header Content-Type text/plain; return 200 "ok\n"; }
    location = /ponto { return 308 /ponto/; }

    location ^~ /ponto-api/ { return 404; }
    location ^~ /ponto/ { return 404; }

    location = /api/consultar-boletos-associado { return 503; }
    location = /api/baixar-boleto { return 503; }
    location /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_connect_timeout 15s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
        proxy_request_buffering off;
    }

    location ~* \.(?:png|jpg|jpeg|gif|ico|svg|webp|woff2?)$ { expires 30d; add_header Cache-Control "public, immutable"; try_files $uri =404; }
    location ~* \.(?:html)$ { expires -1; add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate" always; add_header Pragma "no-cache" always; try_files $uri =404; }
    location ~* \.(?:css|js)$ { expires -1; add_header Cache-Control "no-cache, must-revalidate" always; try_files $uri =404; }

    location /cota/ { try_files $uri $uri/ /cota/index.html; }
    location /associado/ { try_files $uri $uri/ /associado/index.html; }
    location /associados/ { try_files $uri $uri/ /associados/index.html; }
    location /veiculos/ { try_files $uri $uri/ /veiculos/index.html; }
    location /comparacao/ { try_files $uri $uri/ /comparacao/index.html; }
    location /colaborador/ { try_files $uri $uri/ /colaborador/index.html; }
    location /checklist/ { try_files $uri $uri/ /checklist/index.html; }
    location /guincho/ { try_files $uri $uri/ /guincho/index.html; }
    location /oficina/ { try_files $uri $uri/ /oficina/index.html; }
    location /financeiro/ { try_files $uri $uri/ /financeiro/index.html; }
    location /aceite-evento/ { try_files $uri $uri/ /aceite-evento/index.html; }
    location /aceite-termo/ { try_files $uri $uri/ /aceite-termo/index.html; }
    location /retrato/ { try_files $uri $uri/ /retrato/index.html; }
    location /confirmacao-valor/ { try_files $uri $uri/ /confirmacao-valor/index.html; }
    location /admin/ { try_files $uri $uri/ /admin/index.html; }
    location /analise/ { try_files $uri $uri/ /analise/index.html; }
    location /supervisao/ { try_files $uri $uri/ /supervisao/index.html; }
    location / { try_files $uri $uri/ /index.html; }
}
