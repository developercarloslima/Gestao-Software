POSTGRES_DB=pontoproof
POSTGRES_USER=pontoproof
POSTGRES_PASSWORD=troque-por-uma-senha-forte
JWT_SECRET=troque-por-um-segredo-longo-com-pelo-menos-32-caracteres
WEB_ORIGIN=https://ponto.seudominio.com.br
WEB_PORT=8080

# Segurança biométrica. Gere chaves aleatórias fortes e mantenha fora do repositório.
# BIOMETRIC_ENCRYPTION_KEY aceita base64 de 32 bytes ou 64 caracteres hexadecimais.
BIOMETRIC_ENCRYPTION_KEY=COLOQUE_AQUI_32_BYTES_EM_BASE64
AUDIT_PRIVACY_HASH_KEY=troque-por-um-segredo-independente
PRESENCE_SIGNING_SECRET=troque-por-outro-segredo-longo
WEBAUTHN_RP_ID=ponto.seudominio.com.br
WEBAUTHN_RP_NAME=PontoProof
WEBAUTHN_ORIGIN=https://ponto.seudominio.com.br
BIOMETRIC_NOTICE_VERSION=2026-09-v1

# Opcional: URL HTTPS do gateway presente somente na rede da unidade.
VITE_NETWORK_ATTEST_URL=

# Primeiro administrador da instalação. Depois do bootstrap, remova a senha deste arquivo/ambiente.
BOOTSTRAP_TENANT_NAME=Minha Empresa
BOOTSTRAP_TENANT_DOCUMENT=00000000000191
BOOTSTRAP_TIMEZONE=America/Maceio
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_ADMIN_EMAIL=admin@minhaempresa.com.br
BOOTSTRAP_ADMIN_PASSWORD=troque-esta-senha-com-12-ou-mais-caracteres

# true somente se quiser as contas demo.
DEMO_SEED=false


# V83.73 - gravação de tela somente no computador durante períodos de trabalho
WORK_MONITOR_RETENTION_DAYS=3
# WORK_MONITOR_STORAGE_DIR=/data/work-monitor
# WORK_MONITOR_ENCRYPTION_KEY pode ser separado; se omitido usa BIOMETRIC_ENCRYPTION_KEY.
