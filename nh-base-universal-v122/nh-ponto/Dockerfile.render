FROM node:22-alpine AS build
WORKDIR /app
COPY package.json ./
COPY scripts ./scripts
COPY apps/api/package.json ./apps/api/package.json
COPY apps/web/package.json ./apps/web/package.json
COPY apps/presence-gateway/package.json ./apps/presence-gateway/package.json
RUN npm install
COPY prisma ./prisma
COPY apps/api ./apps/api
COPY apps/web ./apps/web
RUN npx prisma generate && npm run build -w @pontoproof/api && npm run build -w @pontoproof/web

FROM node:22-alpine
RUN apk add --no-cache poppler-utils
WORKDIR /app
ENV NODE_ENV=production SERVE_WEB=true
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/apps/web/dist ./apps/web/dist
COPY --from=build /app/prisma ./prisma
COPY package.json ./package.json
COPY entrypoint-nh.sh ./entrypoint-nh.sh
RUN chmod +x ./entrypoint-nh.sh
EXPOSE 10000
ENTRYPOINT ["./entrypoint-nh.sh"]
