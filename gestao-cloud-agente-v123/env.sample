# EXEMPLAR DE CONFIGURAÇÃO DO AGENTE. NÃO É UM .env EXECUTÁVEL EM PRODUÇÃO.
# A chave mestra fica APENAS na Gestão. O agente recebe HMAC(SHA256, master, UUID da VPS).
GESTAO_API_URL=https://gestaosoftware.com.br
WORKER_VPS_ID=COLOQUE_UUID_DA_VPS_CADASTRADA
PROVISIONER_WORKER_TOKEN=TOKEN_DERIVADO_DA_VPS_E_NAO_CHAVE_MESTRA
TENANT_WORKDIR=/var/lib/gestao/tenants
TENANT_ALLOWED_HOST_SUFFIX=gestaosoftware.com.br
GESTAO_CONTROL_URL=https://gestaosoftware.com.br
GESTAO_CONTROL_PUBLIC_URL=https://gestaosoftware.com.br
TRAEFIK_PUBLIC_NETWORK=gestao_public
TRAEFIK_CERTRESOLVER=letsencrypt
# Referências por digest, somente APÓS pipeline publicar e certificar as sete imagens.
NH_BACKEND_IMAGE=ghcr.io/ORGANIZACAO/gestao-tenant-backend@sha256:INSIRA_O_DIGEST_REAL
NH_WEB_IMAGE=ghcr.io/ORGANIZACAO/gestao-tenant-web@sha256:INSIRA_O_DIGEST_REAL
NH_PONTO_API_IMAGE=ghcr.io/ORGANIZACAO/gestao-tenant-ponto-api@sha256:INSIRA_O_DIGEST_REAL
NH_PONTO_WEB_IMAGE=ghcr.io/ORGANIZACAO/gestao-tenant-ponto-web@sha256:INSIRA_O_DIGEST_REAL
NH_HINOVA_IMAGE=ghcr.io/ORGANIZACAO/gestao-tenant-hinova@sha256:INSIRA_O_DIGEST_REAL
NH_FACE_IMAGE=ghcr.io/ORGANIZACAO/gestao-tenant-face@sha256:INSIRA_O_DIGEST_REAL
NH_FIPE_IMAGE=ghcr.io/ORGANIZACAO/gestao-tenant-fipe@sha256:INSIRA_O_DIGEST_REAL
ALLOW_RESOURCE_CREATION=no

# Gestão Cloud v104: o agente envia heartbeat a cada ~45 segundos.
# Não altere o domínio do tenant depois de publicado sem migração controlada.
