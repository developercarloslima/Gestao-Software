WEB_PORT=3100
POSTGRES_DB=gestao_control
POSTGRES_USER=gestao
POSTGRES_PASSWORD=troque-esta-senha
AUTH_TOKEN_SECRET=troque-por-uma-chave-com-pelo-menos-32-caracteres
AUTH_TOKEN_HOURS=12
ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,https://gestaosoftware.com.br,https://www.gestaosoftware.com.br

# Provisionamento: DESATIVADO até conectar um agente de infraestrutura e revisar o contrato.
AUTO_PROVISION_ENABLED=false
PROVISIONER_WORKER_TOKEN=
GESTAO_ASAAS_API_KEY=
GESTAO_ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
GESTAO_ASAAS_WEBHOOK_SECRET=

# Somente subdomínios sob este domínio podem ser implantados automaticamente
PROVISIONING_HOST_SUFFIX=gestaosoftware.com.br

# Ative somente após auditoria white-label + testes E2E e carga da base
TENANT_TEMPLATE_CERTIFIED=false

# Gestão Cloud v104: exige reserva única e agente online para enfileirar quando habilitado
CLOUD_ROUTING_ENABLED=false

# Habilitar somente após testes PostgreSQL, Docker, DNS, rollback e aceite de homologação
CLOUD_ORCHESTRATOR_ENABLED=false

# Opcional: automação de DNS para 50 VPS. Credencial restrita à zona e permissão DNS Edit.
CLOUD_DNS_PROVIDER=MANUAL
CLOUDFLARE_DNS_TOKEN=
CLOUDFLARE_ZONE_ID=

# Contas iniciais: mínimo de 8 caracteres, sem senhas padrão.
GESTAO_BOOTSTRAP_CARLOS_PASSWORD=
GESTAO_BOOTSTRAP_PEDRO_PASSWORD=
